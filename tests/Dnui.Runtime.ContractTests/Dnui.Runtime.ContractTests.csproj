<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RepoRoot>
    <RuntimeExeName Condition="'$(OS)' == 'Windows_NT'">Dnui.Runtime.exe</RuntimeExeName>
    <RuntimeExeName Condition="'$(OS)' != 'Windows_NT'">Dnui.Runtime</RuntimeExeName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Dnui\Dnui.csproj" />
    <!-- Build-order only: the runtime executable and test apps are run, not referenced. -->
    <ProjectReference Include="..\..\Dnui.Runtime\Dnui.Runtime.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Dnui.TestApps\Dnui.TestApps.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DnuiRuntimeExe" Value="$(RepoRoot)/Dnui.Runtime/bin/$(Configuration)/$(TargetFramework)/$(RuntimeExeName)" />
    <AssemblyMetadata Include="DnuiTestAppsDll" Value="$(RepoRoot)/tests/Dnui.TestApps/bin/$(Configuration)/$(TargetFramework)/Dnui.TestApps.dll" />
    <AssemblyMetadata Include="DnuiRepoRoot" Value="$(RepoRoot)" />
  </ItemGroup>

</Project>
