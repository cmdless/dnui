<Project>
  <!--
    dotnet build Dnui.Runtime -t:PackRuntime -p:RuntimeIdentifier=<rid>
    Publishes a self-contained runtime for <rid> and packs it as
    artifacts/packages/Cmdless.Dnui.Runtime.<rid>.<DnuiRuntimeVersion>.nupkg (research R14).
  -->
  <PropertyGroup>
    <DnuiArtifactsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts'))</DnuiArtifactsDir>
  </PropertyGroup>

  <Target Name="PackRuntime">
    <Error Condition="'$(RuntimeIdentifier)' == ''" Text="PackRuntime requires -p:RuntimeIdentifier=&lt;rid&gt;." />

    <PropertyGroup>
      <!-- Native separators throughout: NuGet computes package paths wrongly from mixed ones on Windows. -->
      <_DnuiPublishDir>$([MSBuild]::NormalizeDirectory('$(DnuiArtifactsDir)', 'runtime', '$(RuntimeIdentifier)'))</_DnuiPublishDir>
      <_DnuiPackagesDir>$([MSBuild]::NormalizeDirectory('$(DnuiArtifactsDir)', 'packages'))</_DnuiPackagesDir>
      <_DnuiExeName Condition="$(RuntimeIdentifier.StartsWith('win-'))">Dnui.Runtime.exe</_DnuiExeName>
      <_DnuiExeName Condition="!$(RuntimeIdentifier.StartsWith('win-'))">Dnui.Runtime</_DnuiExeName>
      <_DnuiPackageId>Cmdless.Dnui.Runtime.$(RuntimeIdentifier)</_DnuiPackageId>
      <_DnuiPackagePath>$(_DnuiPackagesDir)$(_DnuiPackageId).$(DnuiRuntimeVersion).nupkg</_DnuiPackagePath>
    </PropertyGroup>

    <RemoveDir Directories="$(_DnuiPublishDir)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=false -p:PublishTrimmed=false -o &quot;$(_DnuiPublishDir)&quot;" />
    <Exec Command="dotnet pack &quot;$(MSBuildThisFileDirectory)../../build/RuntimePackage/RuntimePackage.csproj&quot; -c Release -o &quot;$(_DnuiPackagesDir.TrimEnd('\').TrimEnd('/'))&quot; -p:DnuiRid=$(RuntimeIdentifier) -p:DnuiPublishDir=&quot;$(_DnuiPublishDir.TrimEnd('\').TrimEnd('/'))&quot;" />
    <!-- Fail at pack time, not at download time, if the executable isn't where the downloader expects it. -->
    <Error Condition="!Exists('$(_DnuiPublishDir)$(_DnuiExeName)')" Text="Publish output is missing $(_DnuiPublishDir)$(_DnuiExeName)." />
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)VerifyPackage.cs&quot; &quot;$(_DnuiPackagePath)&quot; runtime/$(_DnuiExeName)" />
    <Message Importance="high" Text="Packed $(_DnuiPackageId) $(DnuiRuntimeVersion) into $(_DnuiPackagesDir)" />
  </Target>
</Project>
