<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Cmdless.Dnui</PackageId>
    <Description>Cross-platform UI through a cached, per-platform Avalonia runtime. Show a tray (and more) from any .NET app with no UI framework dependency on your side.</Description>
    <Authors>Cmdless</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DnuiRuntimeVersion" Value="$(DnuiRuntimeVersion)" />
  </ItemGroup>

  <!-- Non-platform Avalonia packages: DnuiApp.Configure applies the default builder setup.
       Platform backends (Avalonia.Desktop) belong to Dnui.Runtime only. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StreamJsonRpc" Version="2.26.150" />
  </ItemGroup>

  <ItemGroup>
    <!-- buildTransitive: consumers (and their consumers) get the dnui/ shipping target. -->
    <None Include="build/Cmdless.Dnui.targets" Pack="true" PackagePath="buildTransitive/Cmdless.Dnui.targets" />
  </ItemGroup>

</Project>
